# Copy to services/api/.env (backend) and apps/web/.env.local (frontend)

# ---- Backend (prefix DEFISCOPE_) ----
# Data source (public, no key needed)
DEFISCOPE_DEFILLAMA_BASE_URL=https://api.llama.fi

# SQLite by default; use Postgres (docker-compose) with:
# DEFISCOPE_DATABASE_URL=postgresql+psycopg://defiscope:defiscope@localhost:5432/defiscope
DEFISCOPE_DATABASE_URL=sqlite:///./defiscope.db

# Comma-separated DefiLlama slugs monitored by the dashboard & scheduler
DEFISCOPE_DEFAULT_PROTOCOLS=aave-v3,uniswap-v3,lido,curve-dex,compound-v3

# Optional LLM for research briefs (OpenAI-compatible). Without a key the
# deterministic template engine generates the briefs instead.
#DEFISCOPE_OPENAI_API_KEY=sk-...
#DEFISCOPE_OPENAI_BASE_URL=https://api.openai.com/v1
#DEFISCOPE_OPENAI_MODEL=gpt-4o-mini

# Alert thresholds
DEFISCOPE_ALERT_TVL_DROP_PCT=-15
DEFISCOPE_ALERT_TVL_SURGE_PCT=30
DEFISCOPE_ALERT_STAKING_RATIO=0.6
DEFISCOPE_ALERT_STALE_DATA_DAYS=2

# Alert delivery (all optional). New alerts are always persisted; these control
# fan-out to notification channels. With no config the pass logs alerts to the
# console only. Set a webhook URL to activate it, or add Slack/Discord/Telegram/
# email secrets to enable those channels. NEVER commit real secrets.
# Channels to build, comma-separated: console,webhook,slack,discord,telegram,email
#DEFISCOPE_ALERT_NOTIFY_CHANNELS=console,webhook
#DEFISCOPE_ALERT_NOTIFY_ENABLED=true
# Skip re-notifying the same alert within this window (minutes). Alert ids are
# per protocol/rule/day, so this bounds how often a still-firing alert re-pings.
#DEFISCOPE_ALERT_NOTIFY_COOLDOWN_MINUTES=360
# Only deliver alerts at/above this severity: info | warning | critical
#DEFISCOPE_ALERT_NOTIFY_MIN_SEVERITY=info
#DEFISCOPE_ALERT_NOTIFY_WEBHOOK_URL=https://example.com/hooks/defiscope
# Body shape: generic (full JSON) | slack | discord
#DEFISCOPE_ALERT_NOTIFY_WEBHOOK_FORMAT=generic

# Provider secrets - set only the channel(s) you use.
#DEFISCOPE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#DEFISCOPE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
#DEFISCOPE_TELEGRAM_BOT_TOKEN=...
#DEFISCOPE_TELEGRAM_CHAT_ID=...
#DEFISCOPE_SMTP_HOST=smtp.example.com
#DEFISCOPE_SMTP_PORT=587
#DEFISCOPE_SMTP_USERNAME=
#DEFISCOPE_SMTP_PASSWORD=
#DEFISCOPE_SMTP_STARTTLS=true
#DEFISCOPE_SMTP_FROM=alerts@example.com
#DEFISCOPE_SMTP_TO=oncall@example.com

# ---- Frontend (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser-facing API URL (docs link). Only differs from NEXT_PUBLIC_API_URL in
# Docker, where the server uses the internal `http://api:8000` but the browser
# needs the published host address. Locally it's the same, so it can be omitted.
# NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:8000

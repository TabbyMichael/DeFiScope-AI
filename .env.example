# Copy to services/api/.env (backend) and apps/web/.env.local (frontend)

# ---- Backend (prefix DEFISCOPE_) ----
# Data source (public, no key needed)
DEFISCOPE_DEFILLAMA_BASE_URL=https://api.llama.fi

# SQLite by default; use Postgres (docker-compose) with:
# DEFISCOPE_DATABASE_URL=postgresql+psycopg://defiscope:defiscope@localhost:5432/defiscope
DEFISCOPE_DATABASE_URL=sqlite:///./defiscope.db

# Comma-separated DefiLlama slugs monitored by the dashboard & scheduler
DEFISCOPE_DEFAULT_PROTOCOLS=aave-v3,uniswap-v3,lido,curve-dex,compound-v3

# Optional LLM for research briefs (OpenAI-compatible). Without a key the
# deterministic template engine generates the briefs instead.
#DEFISCOPE_OPENAI_API_KEY=sk-...
#DEFISCOPE_OPENAI_BASE_URL=https://api.openai.com/v1
#DEFISCOPE_OPENAI_MODEL=gpt-4o-mini

# Ask-the-analyst chat (roadmap #8). Reuses the OPENAI_API_KEY above for
# embeddings + grounded answers. With NO key the chat still works: retrieval
# falls back to a pure-Python BM25 index and answers are composed extractively
# from quoted evidence. Everything here is optional (sensible defaults shown).
#DEFISCOPE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#DEFISCOPE_EMBEDDING_DIMENSIONS=1536
#DEFISCOPE_RAG_ENABLED=true
#DEFISCOPE_RAG_TOP_K=6
#DEFISCOPE_RAG_CHUNK_SIZE=800
# Relevance gates (decide when the analyst should refuse instead of quoting
# weak matches). Two score scales need two bars:
#  - vector/cosine floor, scores in [0,1] (only used when embeddings are on):
#DEFISCOPE_RAG_MIN_SCORE=0.5
#  - offline BM25 path has unbounded scores, so instead a passage must share at
#    least this many distinct informative query terms (raise to tighten):
#DEFISCOPE_RAG_MIN_QUERY_TERM_OVERLAP=2
# Where the methodology/architecture docs live (dev default auto-finds repo docs/)
#DEFISCOPE_RAG_DOCS_DIR=./docs
# Answer style: higher temperature + a larger token budget give fuller, more
# engaging prose. Honesty is kept by the system prompt (cite [n], say what it
# cannot establish, never invent numbers), not by restraining the model here.
#DEFISCOPE_RAG_TEMPERATURE=0.5
#DEFISCOPE_RAG_MAX_TOKENS=1600
# Generation timeout (seconds). Keep generous for local CPU models, which are
# slow; a too-low value makes the app fall back to the offline extractive answer.
#DEFISCOPE_RAG_LLM_TIMEOUT_SECONDS=150

# ---- Free LOCAL LLM via Docker (optional, no cloud key / cost) ----
# "Ask the analyst" can run fully local on Ollama instead of OpenAI. Start the
# opt-in container, pull a model, then point the OpenAI-compatible settings at
# it. Use Ollama's /v1 shim (NOT native /api/chat) so streaming works unchanged:
#   docker compose --profile llm up -d
#   docker compose exec ollama ollama pull qwen2.5:7b-instruct
#   DEFISCOPE_OPENAI_API_KEY=ollama        # any non-empty value; our code
#                                          # enables the LLM path only when a key
#                                          # is SET - Ollama ignores the token.
#   DEFISCOPE_OPENAI_BASE_URL=http://ollama:11434/v1   # in Docker
#     (host run: http://localhost:11434/v1)
#   DEFISCOPE_OPENAI_MODEL=qwen2.5:7b-instruct
# Retrieval stays on the built-in BM25 lexical index (no embeddings needed), so
# there is NO embedding-dimension/DB work required for a local LLM. Only if you
# later enable Ollama EMBEDDINGS must you set DEFISCOPE_EMBEDDING_DIMENSIONS to
# the model's native size (e.g. 768 for nomic-embed-text) BEFORE migrating, and
# re-index from scratch. If Ollama is ever down, the chat auto-degrades to the
# offline BM25 + extractive answers - the demo never hard-depends on it.

# Alert thresholds
DEFISCOPE_ALERT_TVL_DROP_PCT=-15
DEFISCOPE_ALERT_TVL_SURGE_PCT=30
DEFISCOPE_ALERT_STAKING_RATIO=0.6
DEFISCOPE_ALERT_STALE_DATA_DAYS=2

# Alert delivery (all optional). New alerts are always persisted; these control
# fan-out to notification channels. With no config the pass logs alerts to the
# console only. Set a webhook URL to activate it, or add Slack/Discord/Telegram/
# email secrets to enable those channels. NEVER commit real secrets.
# Channels to build, comma-separated: console,webhook,slack,discord,telegram,email
#DEFISCOPE_ALERT_NOTIFY_CHANNELS=console,webhook
#DEFISCOPE_ALERT_NOTIFY_ENABLED=true
# Skip re-notifying the same alert within this window (minutes). Alert ids are
# per protocol/rule/day, so this bounds how often a still-firing alert re-pings.
#DEFISCOPE_ALERT_NOTIFY_COOLDOWN_MINUTES=360
# Only deliver alerts at/above this severity: info | warning | critical
#DEFISCOPE_ALERT_NOTIFY_MIN_SEVERITY=info
#DEFISCOPE_ALERT_NOTIFY_WEBHOOK_URL=https://example.com/hooks/defiscope
# Body shape: generic (full JSON) | slack | discord
#DEFISCOPE_ALERT_NOTIFY_WEBHOOK_FORMAT=generic

# Provider secrets - set only the channel(s) you use.
#DEFISCOPE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#DEFISCOPE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
#DEFISCOPE_TELEGRAM_BOT_TOKEN=...
#DEFISCOPE_TELEGRAM_CHAT_ID=...
#DEFISCOPE_SMTP_HOST=smtp.example.com
#DEFISCOPE_SMTP_PORT=587
#DEFISCOPE_SMTP_USERNAME=
#DEFISCOPE_SMTP_PASSWORD=
#DEFISCOPE_SMTP_STARTTLS=true
#DEFISCOPE_SMTP_FROM=alerts@example.com
#DEFISCOPE_SMTP_TO=oncall@example.com

# ---- Frontend (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser-facing API URL (docs link). Only differs from NEXT_PUBLIC_API_URL in
# Docker, where the server uses the internal `http://api:8000` but the browser
# needs the published host address. Locally it's the same, so it can be omitted.
# NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:8000
# Browser-reachable WebSocket base for streamed chat tokens. Next can't reliably
# proxy WebSockets, so the browser opens this socket directly. In Docker set it
# to the host-published API port (ws://localhost:3646). Falls back to deriving
# ws:/wss: from NEXT_PUBLIC_API_PUBLIC_URL when unset (correct for local dev).
# NEXT_PUBLIC_API_WS_URL=ws://localhost:8000

    "/api/auth/switch": {
      "post": {
        "description": "Demo only: become another seeded account without typing a password.\n\nDisabled in ``required`` mode - impersonation is a tour affordance, not a\nfeature of a real deployment. The caller's previous session is revoked so\nthe switch is an identity transition rather than a second live credential.",
        "operationId": "switch_api_auth_switch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchRequest"

  "info": {
    "description": "DeFi protocol research, explainable risk scoring and monitoring API",
    "title": "DeFiScope AI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/alerts": {
      "get": {
        "description": "Today's active alerts, served straight from the durable log.\n\nThis is a fast DB read - it does NOT trigger a crawl. The scheduler and\n``POST /api/alerts/run`` are the owners of the (expensive) DefiLlama\nmonitoring pass that populates these rows.",
        "operationId": "current_alerts_api_alerts_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Current Alerts Api Alerts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Current Alerts",
        "tags": [
          "alerts"
        ]
      }
    },
    "/api/alerts/history": {
      "get": {
        "operationId": "alert_history_api_alerts_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Alert History Api Alerts History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Alert History",
        "tags": [
          "alerts"
        ]
      }
    },
    "/api/alerts/run": {
      "post": {
        "description": "Manual/admin trigger for a full monitoring pass: crawl the watchlist,\nevaluate rules, persist alerts + daily snapshots, then return the alerts\nthat fired on this pass (the same set ``GET /api/alerts`` will now serve).",
        "operationId": "run_alert_check_api_alerts_run_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Run Alert Check Api Alerts Run Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Run Alert Check",
        "tags": [
          "alerts"
        ]
      }
    },
    "/api/briefs/{slug}": {
      "get": {
        "operationId": "protocol_brief_api_briefs__slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {

                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Switch",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/ticket": {
      "post": {
        "description": "Mint a single-use, short-lived credential for the browser's WebSocket.\n\nGated on ``chat:ask`` so the ticket can never out-rank the verb that\nmatters: a role that cannot ask questions cannot get a socket either.",

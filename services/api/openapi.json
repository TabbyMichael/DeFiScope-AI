              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "protocols": {
            "items": {
              "$ref": "#/components/schemas/ProtocolOverview"
            },
            "title": "Protocols",
            "type": "array"
          },
          "stats": {
            "$ref": "#/components/schemas/DashboardStats"
          },
          "withheld_alerts": {
            "default": 0,
            "title": "Withheld Alerts",
            "type": "integer"
          }
        },
        "required": [
          "stats"
        ],
        "title": "DashboardResponse",
        "type": "object"
      },

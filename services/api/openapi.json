      "OnchainActivityOut": {
        "description": "On-chain activity from Dune - the second, additive data provider.\n\nAlways present on a research payload, because *why* there is no number is\npart of the answer: ``unconfigured`` (no key), ``no_data`` (no curated\nmapping or nothing captured yet), ``stale``, ``partial`` (a mapped chain\ndid not report) or ``ok``. An omitted block could not tell those apart, and\na zero would assert \"no activity\" - a claim these measurements never make.\n\n``source`` is per block rather than per protocol: this block is Dune's,\nwhile ``ProtocolOverview.source`` stays DefiLlama's.",
        "properties": {
          "active_wallets": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Wallets"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "chains": {
            "items": {
              "type": "string"
            },
            "title": "Chains",
            "type": "array"
          },
          "missing_chains": {
            "items": {
              "type": "string"
            },
            "title": "Missing Chains",
            "type": "array"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "returning_wallet_share": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Returning Wallet Share"
          },
          "returning_wallets": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Returning Wallets"
          },
          "source": {
            "const": "dune",
            "default": "dune",
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "stale",
              "no_data",
              "unconfigured"
            ],
            "title": "Status",
            "type": "string"
          },
          "tx_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tx Count"
          },
          "tx_volume_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tx Volume Usd"
          }
        },
        "required": [
          "status"
        ],
        "title": "OnchainActivityOut",
        "type": "object"
      },

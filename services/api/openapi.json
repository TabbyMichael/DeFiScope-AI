      "DashboardResponse": {
        "description": "Everything the dashboard needs, sourced from the DB (latest snapshot\nper protocol + alert_records) with a live DefiLlama hydration fallback.\n\n``withheld_alerts`` is the number of critical alerts the caller's clearance\nwas not sufficient to read. It is reported rather than hidden: a board that\nsilently shows three fewer alerts than exist would be lying by omission.",
        "properties": {
          "aggregate_history": {
            "items": {
              "$ref": "#/components/schemas/TvlPoint"
            },
            "title": "Aggregate History",
            "type": "array"
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "title": "Alerts",
            "type": "array"

        "title": "SubjectOut",
        "type": "object"
      },
      "SwitchRequest": {
        "description": "Demo-mode role switch: re-issue a session for another seeded account.",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "SwitchRequest",
        "type": "object"
      },
      "TicketResponse": {
        "description": "Single-use credential for the browser-opened ``WS /ws/chat`` socket.",
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "ticket": {
            "title": "Ticket",
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "expires_in"
        ],
        "title": "TicketResponse",
        "type": "object"
      },
      "TvlPoint": {
        "properties": {
          "date": {
            "title": "Date",
            "type": "string"
          },
          "tvl": {
            "title": "Tvl",
            "type": "number"
          }
        },
        "required": [
          "date",
          "tvl"
        ],
        "title": "TvlPoint",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "DeFi protocol research, explainable risk scoring and monitoring API",
    "title": "DeFiScope AI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/alerts": {
      "get": {
        "description": "Today's active alerts, served straight from the durable log.\n\nThis is a fast DB read - it does NOT trigger a crawl. The scheduler and\n``POST /api/alerts/run`` are the owners of the (expensive) DefiLlama\nmonitoring pass that populates these rows.\n\nCritical alerts above the caller's clearance are withheld from the body and\ncounted in ``X-Withheld-Alerts``: the reader still learns that something\nbroke, without learning what.",
        "operationId": "current_alerts_api_alerts_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Current Alerts Api Alerts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Current Alerts",
        "tags": [
          "alerts"
        ]
      }
    },
    "/api/alerts/history": {
      "get": {
        "operationId": "alert_history_api_alerts_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Alert History Api Alerts History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Alert History",
        "tags": [
          "alerts"
        ]
      }
    },
    "/api/alerts/run": {
      "post": {
        "description": "Manual trigger for a full monitoring pass: crawl the watchlist,\nevaluate rules, persist alerts + daily snapshots, then return the alerts\nthat fired on this pass (the same set ``GET /api/alerts`` will now serve).\n\nGated twice beyond the role: a pass outside business hours is refused, and a\npass over a *fresh* snapshot is refused as redundant - a crawl that cannot\nchange anything is wasted upstream quota, not diligence. Both denials come\nback as an explanation rather than a bare 403.",
        "operationId": "run_alert_check_api_alerts_run_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Run Alert Check Api Alerts Run Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Run Alert Check",
        "tags": [
          "alerts"
        ]
      }
    },

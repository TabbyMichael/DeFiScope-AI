    "/api/briefs/{slug}/export": {
      "get": {
        "description": "Render the brief for download as Markdown, CSV or PDF.\n\nReturns raw bytes with a ``Content-Disposition: attachment`` header so the\nbrowser saves the file. Unknown formats are a 400; an unfetchable protocol\nis a 404 (mirrors the JSON brief endpoint). The web app proxies this through\na same-origin route handler so the compose-internal API URL stays server-side.\n\nThe confidence gate is evaluated after the brief is composed because\nconfidence is a property of the brief itself - there is no cheaper way to\nknow it in advance. A denied export therefore costs the same generation as\nan allowed one; the cost ceiling for that lives in the deferred\nper-subject rate limiting, not here.",
        "operationId": "export_brief_api_briefs__slug__export_get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "download format: md | csv | pdf",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "md",
              "description": "download format: md | csv | pdf",
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export Brief",
        "tags": [
          "briefs"
        ]
      }
    },
